{
  "name": "carrefour-drive-mcp",
  "version": "2.0.0",
  "description": "MCP server for Carrefour Drive (carrefour.fr) \u2014 48 tools to search groceries, build a cart, book a Drive slot and read loyalty data from Claude, Cursor or any MCP client",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "carrefour-drive-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "tools",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test 'dist/__tests__/*.test.js'",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run build && node --test 'dist/__tests__/*.test.js' && node scripts/smoke.mjs",
    "postinstall": "playwright install chromium",
    "prepare": "tsc",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "ai-agent",
    "carrefour",
    "carrefour-drive",
    "grocery",
    "groceries",
    "shopping",
    "courses",
    "drive",
    "france"
  ],
  "author": "Maxime Allanic",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "dotenv": "^16.4.5",
    "tough-cookie": "^4.1.4",
    "zod": "^3.24.0",
    "winston": "^3.13.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tough-cookie": "^4.0.5",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximeallanic/CarrefourDriveMCP.git"
  },
  "bugs": {
    "url": "https://github.com/maximeallanic/CarrefourDriveMCP/issues"
  },
  "homepage": "https://github.com/maximeallanic/CarrefourDriveMCP#readme"
}
