{
  "name": "carrefour-drive-mcp",
  "version": "2.0.0",
  "description": "Standalone MCP server for the Carrefour Drive (carrefour.fr) private API — 43 endpoints served by a generic executor, driven through a real Chromium to get past Cloudflare",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "carrefour-drive-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "tools",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test 'dist/__tests__/*.test.js'",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run build && node --test 'dist/__tests__/*.test.js' && node scripts/smoke.mjs",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "carrefour",
    "drive",
    "grocery",
    "shopping"
  ],
  "author": "Maxime Allanic",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "dotenv": "^16.4.5",
    "tough-cookie": "^4.1.4",
    "zod": "^3.24.0",
    "winston": "^3.13.0",
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tough-cookie": "^4.0.5",
    "typescript": "^5.8.0"
  }
}
